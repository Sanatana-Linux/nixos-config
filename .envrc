# direnv only watches flake.nix/flake.lock on its own, so an edit to the dev
# shell definition would keep reusing a cached profile and replay the stale
# shellHook. Watch the files that actually define the shell.
watch_file flake.nix
watch_file flake.lock
watch_file shell.nix

export NIX_CONFIG="experimental-features = recursive-nix cgroups nix-command flakes"
use flake . --builders ''
