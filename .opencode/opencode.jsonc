{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/deepseek-v4-flash:cloud",
  "default_agent": "hubs",
  "provider": {
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  },
  "permission": {
    "bash": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "instructions": [
    ".opencode/rules/nix-flake-strategy.md",
    ".opencode/rules/project-constraints.md",
    ".opencode/rules/comment-style.md",
    ".opencode/rules/nix-service-scripts.md",
    ".opencode/rules/nix-module-patterns.md",
    ".opencode/rules/nix-secrets-management.md",
    ".opencode/rules/nix-pkgs-system-deprecation.md",
    ".opencode/rules/graph-context.md"
  ],
  "tools": {
    "nix-build": true,
    "nix-flake": true,
    "nix-format": true
  },
  "mcp": {},
  "skills": {
    "paths": [
      ".opencode/skills/nixos-module",
      ".opencode/skills/nix-flake-ops",
      ".opencode/skills/nixos-debug",
      ".opencode/skills/nix-secrets",
      ".opencode/skills/nix-service-scripts",
      ".opencode/skills/nixos-best-practices",
      ".opencode/skills/nix-packaging-best-practices",
      ".opencode/skills/nixos-btw",
      ".opencode/skills/ultimate-nixos",
      ".opencode/skills/nixos-ops",
      ".opencode/skills/nixos-managing",
      ".opencode/skills/nix-best-practices",
      ".opencode/skills/nix-ecosystem-guide",
      ".opencode/skills/nixos-docs-reference",
      ".opencode/skills/nixos-build-lock"
    ]
  },
  "references": {
    "context": {
      "path": "./.opencode/context",
      "description": "Durable project knowledge base — decisions, patterns, research, frameworks, and theory. Use when seeking project-specific context, ADRs, or discovered patterns."
    },
    "sops-nix": {
      "repository": "Mic92/sops-nix",
      "description": "sops-nix module used for encrypted secrets (age, SSH host keys) across all four hosts. Reference when touching sops.secrets or external/secrets.",
      "hidden": true
    },
    "nixpkgs": {
      "repository": "NixOS/nixpkgs",
      "description": "Primary package set (nixos-unstable). Reference for option names, package attributes, and module behaviour.",
      "hidden": true
    },
    "nixos-hardware": {
      "repository": "NixOS/nixos-hardware",
      "description": "Hardware-specific NixOS modules (e.g. the Lenovo Legion 16irx9h module backing bagalamukhi/matangi).",
      "hidden": true
    },
    "impermanence": {
      "repository": "nix-community/impermanence",
      "description": "Impermanence module used for tmpfs/system state. See context/impermanence.md.",
      "hidden": true
    },
    "lanzaboote": {
      "repository": "nix-community/lanzaboote",
      "description": "Lanzaboote Secure Boot setup. See context/research/lanzaboote-secure-boot.md.",
      "hidden": true
    },
    "flake-utils": {
      "repository": "numtide/flake-utils",
      "description": "Flake helper library — eachSystem/eachDefaultSystem patterns behind the four host outputs.",
      "hidden": true
    },
    "flake-utils-plus": {
      "repository": "gytis-ivaskevicius/flake-utils-plus",
      "description": "Extended flake helpers in use. See context/flake-utils-plus.md.",
      "hidden": true
    },
    "nixpak": {
      "repository": "nixpak/nixpak",
      "description": "Sandboxed app runtimes. See context/nixpak-sandboxing.md.",
      "hidden": true
    },
    "bubblewrap": {
      "repository": "containers/bubblewrap",
      "description": "bubblewrap sandbox backend underpinning nixpak. See context/nixpak-sandboxing.md.",
      "hidden": true
    },
    "lenovo-legion-linux": {
      "repository": "johnfanv2/LenovoLegionLinux",
      "description": "Legion EC/WMI fan, RGB and battery-control tooling behind modules/hardware/lenovo.",
      "hidden": true
    },
    "nixos-guide": {
      "repository": "mikeroyal/NixOS-Guide",
      "description": "External NixOS reference material. See context/research/nix-guides/.",
      "hidden": true
    },
    "lightdm-webkit2-sanatana": {
      "repository": "Sanatana-Linux/lightdm-webkit2-sanatana",
      "description": "In-house LightDM webkit2 greeter theme wired into the sea-greeter display manager module.",
      "hidden": true
    }
  }
}
