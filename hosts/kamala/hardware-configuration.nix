# Do not modify this file by hand in normal use — it is generated by
# ‘nixos-generate-config’ on the target machine and may be overwritten.
#
# This is a STARTER for the Kamala desktop (ASUS Pro WS / AM4, Ryzen 9,
# NVIDIA GTX 1080). Before the first switch, boot the NixOS installer on the
# box and regenerate:
#
#     sudo nixos-generate-config --root /mnt
#     cp /mnt/etc/nixos/hardware-configuration.nix /etc/nixos/hosts/kamala/
#
# or, on an installed system, copy /etc/nixos/hardware-configuration.nix
# here. In particular the filesystem UUIDs below are placeholders and MUST
# be replaced with the real ones (`lsblk -f`, `blkid`).
{
  config,
  lib,
  pkgs,
  modulesPath,
  ...
}: {
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.initrd.availableKernelModules = ["nvme" "xhci_pci" "ahci" "usbhid" "usb_storage" "sd_mod"];
  boot.initrd.kernelModules = [];
  # AMD KVM virtualization (Intel boards use kvm-intel).
  boot.kernelModules = ["kvm-amd"];
  boot.extraModulePackages = [];

  fileSystems."/" = {
    # TODO: replace with the real root UUID (blkid / lsblk -f).
    device = "/dev/disk/by-uuid/00000000-0000-0000-0000-000000000000";
    fsType = "ext4";
  };

  fileSystems."/boot/efi" = {
    # TODO: replace with the real EFI system partition UUID.
    device = "/dev/disk/by-uuid/0000-0000";
    fsType = "vfat";
    options = ["fmask=0022" "dmask=0022"];
  };

  swapDevices = [];

  nixpkgs.system = lib.mkDefault "x86_64-linux";
  # AMD microcode updates (the ASUS Pro WS module also sets this via
  # mkDefault; declaring it here keeps parity with the other hosts).
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
